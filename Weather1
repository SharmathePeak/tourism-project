/*
 * SmartTour Weather
 * No API key required.
 * Uses Open-Meteo.
 */

(() => {
  "use strict";

  const WEATHER_API = "https://api.open-meteo.com/v1/forecast";
  const GEOCODE_API = "https://geocoding-api.open-meteo.com/v1/search";

  const icons = {
    0: "☀️",
    1: "🌤️",
    2: "⛅",
    3: "☁️",
    45: "🌫️",
    48: "🌫️",
    51: "🌦️",
    53: "🌦️",
    55: "🌧️",
    61: "🌦️",
    63: "🌧️",
    65: "🌧️",
    71: "🌨️",
    73: "🌨️",
    75: "❄️",
    80: "🌦️",
    81: "🌧️",
    82: "⛈️",
    95: "⛈️",
    96: "⛈️",
    99: "⛈️"
  };

  const descriptions = {
    0: "Clear sky",
    1: "Mainly clear",
    2: "Partly cloudy",
    3: "Overcast",
    45: "Fog",
    48: "Fog",
    51: "Light drizzle",
    53: "Drizzle",
    55: "Heavy drizzle",
    61: "Light rain",
    63: "Moderate rain",
    65: "Heavy rain",
    71: "Light snow",
    73: "Snow",
    75: "Heavy snow",
    80: "Rain showers",
    81: "Rain showers",
    82: "Heavy rain showers",
    95: "Thunderstorm",
    96: "Thunderstorm",
    99: "Thunderstorm"
  };

  function addStyles() {
    if (document.getElementById("weatherStyles")) return;

    const style = document.createElement("style");
    style.id = "weatherStyles";

    style.textContent = `
      .weather-search {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin: 20px 0;
      }

      .weather-search input,
      .weather-search select {
        flex: 1;
        min-width: 200px;
        padding: 12px;
        border-radius: 10px;
        border: 1px solid var(--border-color);
        background: var(--bg-color);
        color: var(--text-main);
      }

      .weather-btn {
        padding: 12px 18px;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        background: var(--accent);
        color: white;
        font-weight: 700;
      }

      .weather-current {
        display: grid;
        grid-template-columns: 2fr repeat(4, 1fr);
        gap: 12px;
        margin-top: 20px;
      }

      .weather-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 18px;
      }

      .weather-main {
        display: flex;
        align-items: center;
        gap: 15px;
      }

      .weather-icon {
        font-size: 48px;
      }

      .weather-temperature {
        font-size: 34px;
        font-weight: 900;
      }

      .weather-muted {
        color: var(--text-muted);
        font-size: 13px;
      }

      .weather-label {
        color: var(--text-muted);
        font-size: 12px;
        text-transform: uppercase;
        font-weight: 800;
      }

      .weather-value {
        font-size: 20px;
        font-weight: 800;
        margin-top: 8px;
      }

      .weather-forecast {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 12px;
        margin-top: 15px;
      }

      .forecast-card {
        text-align: center;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 15px;
      }

      .forecast-icon {
        font-size: 32px;
        margin: 10px 0;
      }

      .forecast-temp {
        font-weight: 800;
      }

      .rain-chance {
        margin-top: 7px;
        color: var(--text-muted);
        font-size: 12px;
      }

      .weather-status {
        margin: 10px 0;
        color: var(--text-muted);
        font-size: 13px;
      }

      .weather-tip {
        margin-top: 20px;
        padding: 15px;
        border-radius: 10px;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
      }

      @media(max-width: 900px) {
        .weather-current {
          grid-template-columns: repeat(2, 1fr);
        }

        .weather-main {
          grid-column: 1 / -1;
        }

        .weather-forecast {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media(max-width: 500px) {
        .weather-current {
          grid-template-columns: 1fr 1fr;
        }

        .weather-forecast {
          grid-template-columns: 1fr;
        }
      }
    `;

    document.head.appendChild(style);
  }

  function createWeatherPage() {
    if (document.getElementById("weather")) return;

    const nav = document.querySelector(".nav");

    if (nav) {
      const button = document.createElement("button");

      button.id = "weatherNavButton";
      button.dataset.section = "weather";
      button.textContent = "Weather";

      button.onclick = () => {
        showSection("weather", button);
      };

      nav.appendChild(button);
    }

    const planner = document.getElementById("planner");

    if (!planner) return;

    const section = document.createElement("section");

    section.className = "section";
    section.id = "weather";

    section.innerHTML = `
      <div class="simple">

        <h2>🌦️ Weather</h2>

        <p style="color:var(--text-muted);font-size:13px">
          Check the weather before planning your trip.
        </p>

        <div class="weather-search">

          <select id="weatherDestination">
            <option value="">
              Select a SmartTour destination
            </option>
          </select>

          <input
            id="weatherCity"
            type="text"
            placeholder="Search any city..."
          />

          <button
            class="weather-btn"
            id="weatherSearchButton">
            🔎 Search
          </button>

          <button
            class="weather-btn"
            id="weatherLocationButton">
            📍 My Location
          </button>

        </div>

        <div
          id="weatherStatus"
          class="weather-status">
        </div>

        <div id="weatherCurrent"></div>

        <h3 style="margin-top:25px">
          📅 5-Day Forecast
        </h3>

        <div id="weatherForecast"></div>

        <div id="weatherTip"></div>

      </div>
    `;

    planner.parentNode.insertBefore(section, planner);

    populateDestinations();

    document
      .getElementById("weatherSearchButton")
      .onclick = searchCity;

    document
      .getElementById("weatherLocationButton")
      .onclick = getLocation;

    document
      .getElementById("weatherDestination")
      .onchange = function () {

        const name = this.value;

        if (!name || !window.destinations[name]) return;

        const coords = window.destinations[name].coords;

        loadWeather(
          coords[0],
          coords[1],
          name
        );
      };

    document
      .getElementById("weatherCity")
      .addEventListener("keydown", e => {
        if (e.key === "Enter") {
          searchCity();
        }
      });

    // Load first destination automatically
    setTimeout(() => {

      const select =
        document.getElementById("weatherDestination");

      if (
        select &&
        select.options.length > 1
      ) {
        select.selectedIndex = 1;
        select.dispatchEvent(
          new Event("change")
        );
      }

    }, 300);
  }

  function populateDestinations() {

    const select =
      document.getElementById("weatherDestination");

    if (!select || !window.destinations) return;

    Object.keys(window.destinations)
      .forEach(name => {

        const option =
          document.createElement("option");

        option.value = name;
        option.textContent = name;

        select.appendChild(option);
      });
  }

  function setStatus(message) {

    const element =
      document.getElementById("weatherStatus");

    if (element) {
      element.textContent = message;
    }
  }

  async function searchCity() {

    const input =
      document.getElementById("weatherCity");

    const city =
      input.value.trim();

    if (!city) {
      setStatus("Please enter a city.");
      return;
    }

    setStatus("Searching for city...");

    try {

      const url =
        GEOCODE_API +
        "?name=" +
        encodeURIComponent(city) +
        "&count=1&language=en&format=json";

      const response =
        await fetch(url);

      if (!response.ok)
        throw new Error("Search failed");

      const data =
        await response.json();

      if (!data.results || !data.results.length) {

        setStatus(
          "City not found. Try another name."
        );

        return;
      }

      const place =
        data.results[0];

      const name =
        [
          place.name,
          place.admin1,
          place.country
        ]
          .filter(Boolean)
          .join(", ");

      loadWeather(
        place.latitude,
        place.longitude,
        name
      );

    } catch (error) {

      console.error(error);

      setStatus(
        "Unable to search for the city."
      );
    }
  }

  function getLocation() {

    if (!navigator.geolocation) {

      setStatus(
        "Location is not supported by this browser."
      );

      return;
    }

    setStatus(
      "Getting your location..."
    );

    navigator.geolocation.getCurrentPosition(

      position => {

        loadWeather(
          position.coords.latitude,
          position.coords.longitude,
          "Your Location"
        );

      },

      () => {

        setStatus(
          "Location permission was denied."
        );

      }
    );
  }

  async function loadWeather(
    latitude,
    longitude,
    placeName
  ) {

    setStatus(
      "Loading weather..."
    );

    try {

      const params =
        new URLSearchParams({

          latitude,

          longitude,

          current:
            "temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m",

          daily:
            "weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max",

          timezone: "auto",

          forecast_days: "5"

        });

      const response =
        await fetch(
          WEATHER_API +
          "?" +
          params
        );

      if (!response.ok)
        throw new Error(
          "Weather request failed"
        );

      const data =
        await response.json();

      displayWeather(
        data,
        placeName
      );

      setStatus(
        "Weather updated successfully."
      );

    } catch (error) {

      console.error(error);

      setStatus(
        "Unable to load weather. Check your internet connection."
      );
    }
  }

  function displayWeather(
    data,
    placeName
  ) {

    const current =
      data.current;

    const daily =
      data.daily;

    const code =
      Number(current.weather_code);

    const icon =
      icons[code] || "🌡️";

    const description =
      descriptions[code] || "Unknown";

    document.getElementById(
      "weatherCurrent"
    ).innerHTML = `

      <div class="weather-current">

        <div class="weather-card weather-main">

          <div class="weather-icon">
            ${icon}
          </div>

          <div>

            <div class="weather-temperature">
              ${Math.round(current.temperature_2m)}°C
            </div>

            <strong>
              ${description}
            </strong>

            <div class="weather-muted">
              ${escapeHTML(placeName)}
            </div>

          </div>

        </div>

        <div class="weather-card">

          <div class="weather-label">
            Feels Like
          </div>

          <div class="weather-value">
            ${Math.round(
              current.apparent_temperature
            )}°C
          </div>

        </div>

        <div class="weather-card">

          <div class="weather-label">
            Humidity
          </div>

          <div class="weather-value">
            ${Math.round(
              current.relative_humidity_2m
            )}%
          </div>

        </div>

        <div class="weather-card">

          <div class="weather-label">
            Wind
          </div>

          <div class="weather-value">
            ${Math.round(
              current.wind_speed_10m
            )} km/h
          </div>

        </div>

        <div class="weather-card">

          <div class="weather-label">
            Rain Chance
          </div>

          <div class="weather-value">
            ${daily.precipitation_probability_max[0]}%
          </div>

        </div>

      </div>
    `;

    let forecastHTML = "";

    daily.time.forEach(
      (date, index) => {

        const day =
          new Date(
            date + "T12:00:00"
          ).toLocaleDateString(
            undefined,
            {
              weekday: "short",
              day: "numeric",
              month: "short"
            }
          );

        const forecastCode =
          Number(
            daily.weather_code[index]
          );

        forecastHTML += `

          <div class="forecast-card">

            <strong>
              ${day}
            </strong>

            <div class="forecast-icon">
              ${icons[forecastCode] || "🌡️"}
            </div>

            <div class="weather-muted">
              ${descriptions[forecastCode] || "Weather"}
            </div>

            <div class="forecast-temp">
              ${Math.round(
                daily.temperature_2m_max[index]
              )}° /
              ${Math.round(
                daily.temperature_2m_min[index]
              )}°C
            </div>

            <div class="rain-chance">
              💧
              ${daily.precipitation_probability_max[index]}%
              rain
            </div>

          </div>
        `;
      }
    );

    document.getElementById(
      "weatherForecast"
    ).innerHTML = `

      <div class="weather-forecast">
        ${forecastHTML}
      </div>
    `;

    const rain =
      daily.precipitation_probability_max[0];

    let tip;

    if (rain >= 70) {

      tip =
        "🌧️ High chance of rain. Consider keeping outdoor activities flexible.";

    } else if (rain >= 40) {

      tip =
        "☔ There may be some rain. Carry a rain jacket or umbrella.";

    } else {

      tip =
        "☀️ Conditions look good for sightseeing and outdoor activities.";

    }

    document.getElementById(
      "weatherTip"
    ).innerHTML = `

      <div class="weather-tip">
        <strong>SmartTour Tip:</strong>
        ${tip}
      </div>
    `;
  }

  function escapeHTML(value) {

    return String(value)
      .replace(
        /[&<>"']/g,
        character => ({

          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#039;"

        })[character]
      );
  }

  function init() {

    addStyles();

    createWeatherPage();

  }

  if (
    document.readyState === "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      init
    );

  } else {

    init();

  }

})();
